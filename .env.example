# Copy to .env and fill in. Never commit .env.
#
# Bitbucket Server / Data Center 6.7 (source)
# Preferred: an HTTP access token (used as a Bearer token).
BITBUCKET_SERVER_USER=admin
BITBUCKET_SERVER_TOKEN=
# Fallback if no token: basic auth with username + password.
BITBUCKET_SERVER_PASSWORD=

# Bitbucket Cloud (target)
# App passwords are removed; use a scoped API token.
# Create it at https://id.atlassian.com/manage-profile/security/api-tokens
#   -> "Create API token with scopes" -> app: Bitbucket -> select the scopes below.
# A token created without the Bitbucket app/scopes fails with:
#   HTTP 401 "API Token provided has no Bitbucket scopes."
# Required scopes:
#   read:user:bitbucket         connectivity check (GET /user)
#   read:workspace:bitbucket    workspace lookup
#   read:project:bitbucket      list Cloud projects
#   admin:project:bitbucket     create Cloud projects (create_cloud_projects)
#   read:repository:bitbucket   list/view repositories
#   write:repository:bitbucket  push branches and tags
#   admin:repository:bitbucket  create repositories
#   delete:repository:bitbucket rollback: delete a Cloud repo this run created
BITBUCKET_CLOUD_EMAIL=you@example.com
BITBUCKET_CLOUD_API_TOKEN=
BITBUCKET_CLOUD_WORKSPACE=gmf-aeroasia

# Co-op mode (optional) — share progress + config remaps across devices.
# FIREBASE_DB_URL is required to HOST a room. Invitees usually do not need it:
# the invite link embeds the database URL. Create a Firebase project with a
# Realtime Database and paste its URL here. Regional databases use
# https://<name>.<region>.firebasedatabase.app.
FIREBASE_DB_URL=
# Optional: only needed if your RTDB rules require auth. If the host sets this,
# every invitee must set the same value.
FIREBASE_API_KEY=
#
# Co-op rooms are gated by link + passphrase: the database path is derived from
# sha256(roomID + passphrase), and the passphrase is never stored. The rules
# below allow access only under /rooms, so an unguessable path is the gate.
# Set these in Firebase Console -> Realtime Database -> Rules:
#   { "rules": { "rooms": { ".read": true, ".write": true } } }

